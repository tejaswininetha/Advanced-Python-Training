# nesting of looping
# 1.independent loop
for i in range(5):
    for j in range(4):
        print("hi", end=" ")
    print()
#2. dependent loop
for i in range(1,5):
    for j in range(i):
        print("hi", end=" ")
    print()
#independent for loop
a=10
for i in range(4):
    for j in range(i+1):
        a=a+i
    print("ACE")
print(a)
